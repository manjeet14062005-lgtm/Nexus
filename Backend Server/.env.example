# Copy to .env in this backend folder. Never copy secrets to the React environment.
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
NEXUS_PROCESS_ROLE=api
NEXUS_STRICT_STARTUP=false

# Live payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_ENT_MONTHLY=
RAZORPAY_PLAN_ENT_ANNUAL=

# Live phone/email verification and Intelligence
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ANTHROPIC_API_KEY=
# Gemini is selected automatically when its key is present, or set explicitly.
# Keep Google project billing disabled for free-tier use. No paid-provider fallback.
NEXUS_AI_PROVIDER=gemini
GEMINI_API_KEY=

# Generate a 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_ALLOW_HTTP=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXUS_HORIZONTAL_SCALING=false
NEXUS_REQUIRE_DISTRIBUTED_RATE_LIMITING=false
NEXUS_REQUIRE_BILLING=false
NEXUS_REQUIRE_WEBHOOKS=false

# Background jobs are run separately with npm run worker.
WEBHOOK_WORKER_ENABLED=false
REPORT_SCHEDULER_ENABLED=false
AUTOMATION_WORKER_ENABLED=false
SUPPORT_EMAIL=

# Signed phone proof issued after Twilio approval (15 minutes, phone/email bound).
SIGNUP_PROOF_SECRET=
# Supabase Auth > Hooks > Before User Created, HTTP endpoint:
# https://YOUR_API_HOST/auth/before-user-created
SUPABASE_BEFORE_USER_CREATED_SECRET=
NEXUS_SIGNUP_HOOK_ENABLED=false

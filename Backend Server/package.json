{
  "name": "nexus-backend",
  "version": "2.0.0",
  "description": "Nexus verification infrastructure API backed by Supabase Auth and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node worker.js",
    "preflight": "node preflight.js",
    "smoke:e2e": "node e2e_smoke.js",
    "smoke:supabase": "node supabase_static_smoke.js",
    "test": "node --test *.test.js",
    "test:integration": "node readiness_integration.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "razorpay": "^2.9.6",
    "standardwebhooks": "1.1.1",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "nodemon": "^3.1.0"
  }
}
